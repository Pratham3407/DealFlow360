// DealFlow360 - Prisma schema
//
// Mirrors docs/DOMAIN_MODEL.md. Deviations from that document are marked
// "Implementation Decision" and are also recorded in docs/DOMAIN_MODEL.md.
//
// Conventions:
//   - Tables and columns are snake_case; Prisma models/fields stay camelCase.
//   - Money is Decimal(14,2) -> Postgres NUMERIC. Never floating point (AGENTS.md 24).
//   - Percentages are Decimal(6,3), expressed 0..100 (12.5 means 12.5%).
//   - Risk scores are Decimal(10,4) so thresholds stay comparable and exact.
//   - Timestamps are timestamptz; calendar-only values are date.
//   - Users are deactivated, never deleted, so audit attribution survives.

generator client {
  provider = "prisma-client"
  // Prisma 7 requires an explicit output path and emits TypeScript source, so
  // the client lives under src/ where the compiler already looks. Gitignored -
  // regenerate with `npm run db:generate`.
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ===========================================================================
// Identity and access
// ===========================================================================

enum Role {
  ADMIN
  SALES_REP
  SALES_MANAGER
  FINANCE_OPERATIONS
  CUSTOMER
}

model User {
  id           String   @id @default(uuid(7)) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  role         Role
  active       Boolean  @default(true)
  /// Set only for CUSTOMER users. A migration-level CHECK constraint enforces
  /// role = 'CUSTOMER' <=> customer_id IS NOT NULL, making portal isolation
  /// (docs/RBAC.md) a database invariant rather than application convention.
  customerId   String?  @map("customer_id") @db.Uuid
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz(6)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  customer             Customer?            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  sessions             Session[]
  ownedQuotations      Quotation[]          @relation("QuotationSalesRep")
  approvalsReviewed    ApprovalInstance[]   @relation("ApprovalReviewer")
  auditLogs            AuditLog[]
  negotiationResponses NegotiationRequest[] @relation("NegotiationResponder")
  paymentsRecorded     Payment[]            @relation("PaymentRecordedBy")
  creditNotesCreated   CreditNote[]         @relation("CreditNoteCreatedBy")

  @@index([role])
  @@index([customerId])
  @@map("users")
}

/// Implementation Decision: not in docs/DOMAIN_MODEL.md.
/// Server-side session store backing the httpOnly session cookie. Only the
/// SHA-256 hash of the opaque token is persisted, so a database leak does not
/// yield usable session tokens. Role and customerId are re-read from `users` on
/// every request, so the client can never assert its own identity.
model Session {
  id         String   @id @default(uuid(7)) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  tokenHash  String   @unique @map("token_hash")
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  ip         String?
  userAgent  String?  @map("user_agent")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// ===========================================================================
// Customers
// ===========================================================================

model CustomerTier {
  id                     String   @id @default(uuid(7)) @db.Uuid
  code                   String   @unique
  name                   String   @unique
  /// Fallback discount ceiling (percent) when no category-specific rule applies.
  defaultDiscountCeiling Decimal  @map("default_discount_ceiling") @db.Decimal(6, 3)
  active                 Boolean  @default(true)
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  customers     Customer[]
  discountRules DiscountRule[]
  priceLists    PriceList[]

  @@map("customer_tiers")
}

model Customer {
  id             String   @id @default(uuid(7)) @db.Uuid
  code           String   @unique
  name           String
  tierId         String   @map("tier_id") @db.Uuid
  contactName    String?  @map("contact_name")
  contactEmail   String?  @map("contact_email")
  contactPhone   String?  @map("contact_phone")
  billingAddress String?  @map("billing_address")
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tier                CustomerTier         @relation(fields: [tierId], references: [id], onDelete: Restrict)
  users               User[]
  quotations          Quotation[]
  subscriptions       Subscription[]
  invoices            Invoice[]
  negotiationRequests NegotiationRequest[]

  @@index([tierId])
  @@map("customers")
}

// ===========================================================================
// Catalog and pricing
// ===========================================================================

/// Implementation Decision: docs/DOMAIN_MODEL.md lists product_type values
/// ONE_TIME, RECURRING, SERVICE, HARDWARE and SUBSCRIPTION in a single enum,
/// which conflates billing cadence with product kind. Hardware / Services /
/// Subscriptions are modelled as Category rows instead (docs/SEED_DATA.md
/// already treats them as categories), leaving product_type as the billing
/// classification. Hybrid billing (docs/WORKFLOWS.md 8) needs that to be
/// unambiguous.
enum ProductType {
  ONE_TIME
  RECURRING
}

model Category {
  id   String @id @default(uuid(7)) @db.Uuid
  code String @unique
  name String @unique
  /// Indicative gross-margin percent for the category. Reporting/health signals
  /// only - authoritative margin comes from per-product cost.
  defaultMarginPercent Decimal? @map("default_margin_percent") @db.Decimal(6, 3)
  active               Boolean  @default(true)
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  products      Product[]
  discountRules DiscountRule[]

  @@map("categories")
}

model Product {
  id          String      @id @default(uuid(7)) @db.Uuid
  sku         String      @unique
  name        String
  categoryId  String      @map("category_id") @db.Uuid
  productType ProductType @map("product_type")
  unit        String      @default("unit")
  basePrice   Decimal     @map("base_price") @db.Decimal(14, 2)
  /// Implementation Decision: not in docs/DOMAIN_MODEL.md. docs/BUSINESS_RULES.md 6
  /// defines margin = revenue - estimated_cost but the documented Product has no
  /// cost field, making margin uncomputable. That document explicitly leaves the
  /// cost model to implementation; this is the simplest deterministic choice.
  costPrice   Decimal     @map("cost_price") @db.Decimal(14, 2)
  taxPercent  Decimal     @default(0) @map("tax_percent") @db.Decimal(6, 3)
  description String?
  active      Boolean     @default(true)
  /// Required for RECURRING products: which plan governs cadence and proration.
  subscriptionPlanId String? @map("subscription_plan_id") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  category         Category          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  subscriptionPlan SubscriptionPlan? @relation(fields: [subscriptionPlanId], references: [id], onDelete: Restrict)

  variants       ProductVariant[]
  priceListItems PriceListItem[]
  quotationLines QuotationLine[]
  inventory      Inventory[]
  allocations    FulfillmentAllocation[]
  backorders     Backorder[]
  subscriptions  Subscription[]
  invoiceLines   InvoiceLine[]
  pairingSources ProductPairing[]        @relation("PairingSource")
  pairingTargets ProductPairing[]        @relation("PairingRecommended")
  promotions     Promotion[]

  @@index([categoryId])
  @@index([productType])
  @@map("products")
}

model ProductVariant {
  id         String   @id @default(uuid(7)) @db.Uuid
  productId  String   @map("product_id") @db.Uuid
  attribute  String
  value      String
  extraPrice Decimal  @default(0) @map("extra_price") @db.Decimal(14, 2)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  quotationLines QuotationLine[]

  @@unique([productId, attribute, value])
  @@map("product_variants")
}

model PriceList {
  id             String   @id @default(uuid(7)) @db.Uuid
  code           String   @unique
  name           String
  customerTierId String?  @map("customer_tier_id") @db.Uuid
  currency       String   @default("INR")
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  customerTier CustomerTier?   @relation(fields: [customerTierId], references: [id], onDelete: SetNull)
  items        PriceListItem[]

  @@index([customerTierId])
  @@map("price_lists")
}

model PriceListItem {
  id          String  @id @default(uuid(7)) @db.Uuid
  priceListId String  @map("price_list_id") @db.Uuid
  productId   String  @map("product_id") @db.Uuid
  price       Decimal @db.Decimal(14, 2)

  priceList PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([priceListId, productId])
  @@map("price_list_items")
}

// ===========================================================================
// Discount governance and approval configuration
// ===========================================================================

/// Effective ceiling resolution (docs/BUSINESS_RULES.md 1): the most specific
/// active rule wins - a (tier, category) rule beats a (tier, NULL) rule, ties
/// broken by descending priority. A partial unique index added in the migration
/// guarantees at most one tier-wide rule per tier, because Postgres treats NULLs
/// as distinct in ordinary unique indexes.
model DiscountRule {
  id              String   @id @default(uuid(7)) @db.Uuid
  customerTierId  String   @map("customer_tier_id") @db.Uuid
  categoryId      String?  @map("category_id") @db.Uuid
  maximumDiscount Decimal  @map("maximum_discount") @db.Decimal(6, 3)
  priority        Int      @default(0)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  customerTier CustomerTier @relation(fields: [customerTierId], references: [id], onDelete: Cascade)
  category     Category?    @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([customerTierId, categoryId])
  @@index([customerTierId, active])
  @@map("discount_rules")
}

enum ApprovalLevelRequirement {
  NONE
  MANAGER
  MANAGER_FINANCE
}

/// Risk-band -> required approval level. Thresholds are data, never code
/// (docs/BUSINESS_RULES.md 4). maximumRisk NULL means "unbounded upper end".
model ApprovalRule {
  id            String                   @id @default(uuid(7)) @db.Uuid
  name          String                   @unique
  minimumRisk   Decimal                  @map("minimum_risk") @db.Decimal(10, 4)
  maximumRisk   Decimal?                 @map("maximum_risk") @db.Decimal(10, 4)
  requiredLevel ApprovalLevelRequirement  @map("required_level")
  priority      Int                      @default(0)
  active        Boolean                  @default(true)
  createdAt     DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([active, minimumRisk])
  @@map("approval_rules")
}

enum ApprovalStage {
  MANAGER
  FINANCE
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  REVISION_REQUESTED
  CANCELLED
}

/// One row per approval step per quotation version. Recording
/// quotationVersion is what makes approval invalidation possible: an approval
/// only counts while quotation.version still equals the approved version
/// (AGENTS.md 11).
model ApprovalInstance {
  id               String         @id @default(uuid(7)) @db.Uuid
  quotationId      String         @map("quotation_id") @db.Uuid
  quotationVersion Int            @map("quotation_version")
  stage            ApprovalStage
  sequence         Int
  status           ApprovalStatus @default(PENDING)
  reviewerId       String?        @map("reviewer_id") @db.Uuid
  reason           String?
  requestedAt      DateTime       @default(now()) @map("requested_at") @db.Timestamptz(6)
  actedAt          DateTime?      @map("acted_at") @db.Timestamptz(6)

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  reviewer  User?     @relation("ApprovalReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)

  @@unique([quotationId, quotationVersion, stage])
  @@index([status, stage])
  @@index([quotationId, quotationVersion])
  @@map("approval_instances")
}

// ===========================================================================
// Quotation
// ===========================================================================

enum QuotationStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  SENT
  UNDER_NEGOTIATION
  CONFIRMED
  FULFILLMENT
  REJECTED
  REVISION_REQUIRED
}

enum RiskBand {
  LOW
  MEDIUM
  HIGH
}

model Quotation {
  id          String          @id @default(uuid(7)) @db.Uuid
  quoteNumber String          @unique @map("quote_number")
  customerId  String          @map("customer_id") @db.Uuid
  salesRepId  String          @map("sales_rep_id") @db.Uuid
  status      QuotationStatus @default(DRAFT)
  /// Incremented on every material commercial change. Doubles as the optimistic
  /// concurrency token (AGENTS.md 23) and the approval-validity key (AGENTS.md 11).
  version     Int             @default(1)
  currency    String          @default("INR")

  orderDiscountPercent Decimal @default(0) @map("order_discount_percent") @db.Decimal(6, 3)
  subtotal             Decimal @default(0) @db.Decimal(14, 2)
  discountTotal        Decimal @default(0) @map("discount_total") @db.Decimal(14, 2)
  taxTotal             Decimal @default(0) @map("tax_total") @db.Decimal(14, 2)
  grandTotal           Decimal @default(0) @map("grand_total") @db.Decimal(14, 2)
  estimatedCost        Decimal @default(0) @map("estimated_cost") @db.Decimal(14, 2)
  margin               Decimal @default(0) @db.Decimal(14, 2)

  riskScore             Decimal                  @default(0) @map("risk_score") @db.Decimal(10, 4)
  riskBand              RiskBand                 @default(LOW) @map("risk_band")
  requiredApprovalLevel ApprovalLevelRequirement @default(NONE) @map("required_approval_level")
  /// Version that completed the full approval chain. Approval is live only while
  /// approvedVersion == version.
  approvedVersion       Int?                     @map("approved_version")

  notes          String?
  validUntil     DateTime? @map("valid_until") @db.Date
  sentAt         DateTime? @map("sent_at") @db.Timestamptz(6)
  confirmedAt    DateTime? @map("confirmed_at") @db.Timestamptz(6)
  lastActivityAt DateTime  @default(now()) @map("last_activity_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  customer  Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  salesRep  User     @relation("QuotationSalesRep", fields: [salesRepId], references: [id], onDelete: Restrict)

  lines               QuotationLine[]
  approvalInstances   ApprovalInstance[]
  negotiationRequests NegotiationRequest[]
  fulfillment         Fulfillment?
  subscriptions       Subscription[]
  invoices            Invoice[]
  dealHealthEvents    DealHealthEvent[]

  @@index([customerId, status])
  @@index([salesRepId, status])
  @@index([status, lastActivityAt])
  @@map("quotations")
}

model QuotationLine {
  id          String  @id @default(uuid(7)) @db.Uuid
  quotationId String  @map("quotation_id") @db.Uuid
  productId   String  @map("product_id") @db.Uuid
  variantId   String? @map("variant_id") @db.Uuid
  position    Int
  quantity    Int

  /// Price and cost are snapshotted at add time so historical quotations stay
  /// reproducible when the catalog changes.
  unitPrice       Decimal @map("unit_price") @db.Decimal(14, 2)
  unitCost        Decimal @map("unit_cost") @db.Decimal(14, 2)
  discountPercent Decimal @default(0) @map("discount_percent") @db.Decimal(6, 3)
  taxPercent      Decimal @default(0) @map("tax_percent") @db.Decimal(6, 3)

  lineSubtotal Decimal @default(0) @map("line_subtotal") @db.Decimal(14, 2)
  lineDiscount Decimal @default(0) @map("line_discount") @db.Decimal(14, 2)
  lineTax      Decimal @default(0) @map("line_tax") @db.Decimal(14, 2)
  lineTotal    Decimal @default(0) @map("line_total") @db.Decimal(14, 2)
  margin       Decimal @default(0) @db.Decimal(14, 2)

  lineType           ProductType @map("line_type")
  subscriptionPlanId String?     @map("subscription_plan_id") @db.Uuid
  createdAt          DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  quotation        Quotation         @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  product          Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant          ProductVariant?   @relation(fields: [variantId], references: [id], onDelete: Restrict)
  subscriptionPlan SubscriptionPlan? @relation(fields: [subscriptionPlanId], references: [id], onDelete: Restrict)

  negotiationRequests NegotiationRequest[]
  allocations         FulfillmentAllocation[]
  backorders          Backorder[]

  @@unique([quotationId, position])
  @@index([quotationId])
  @@index([productId])
  @@map("quotation_lines")
}

enum NegotiationRequestType {
  QUESTION
  DISCOUNT_COUNTER
  QUANTITY_CHANGE
  LINE_CHANGE
  COMMERCIAL_CHANGE
}

enum NegotiationRequestStatus {
  OPEN
  ACCEPTED
  APPLIED
  REJECTED
  WITHDRAWN
}

model NegotiationRequest {
  id               String                   @id @default(uuid(7)) @db.Uuid
  quotationId      String                   @map("quotation_id") @db.Uuid
  customerId       String                   @map("customer_id") @db.Uuid
  /// Version the customer was looking at, so a proposal can never be applied to
  /// a quotation that has moved on underneath it (docs/BUSINESS_RULES.md 10).
  quotationVersion Int                      @map("quotation_version")
  requestType      NegotiationRequestType   @map("request_type")
  lineId           String?                  @map("line_id") @db.Uuid
  proposedValue    Decimal?                 @map("proposed_value") @db.Decimal(14, 4)
  comment          String?
  status           NegotiationRequestStatus @default(OPEN)
  respondedById    String?                  @map("responded_by_id") @db.Uuid
  responseComment  String?                  @map("response_comment")
  createdAt        DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  respondedAt      DateTime?                @map("responded_at") @db.Timestamptz(6)

  quotation   Quotation      @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  customer    Customer       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  line        QuotationLine? @relation(fields: [lineId], references: [id], onDelete: SetNull)
  respondedBy User?          @relation("NegotiationResponder", fields: [respondedById], references: [id], onDelete: Restrict)

  @@index([quotationId, status])
  @@index([customerId])
  @@map("negotiation_requests")
}

// ===========================================================================
// Inventory and fulfillment
// ===========================================================================

model Warehouse {
  id   String @id @default(uuid(7)) @db.Uuid
  code String @unique
  name String
  /// Relative shipping-cost weighting used by the allocation recommendation
  /// (docs/BUSINESS_RULES.md 7). Lower is cheaper to ship from.
  shippingWeight Decimal  @default(1) @map("shipping_weight") @db.Decimal(10, 4)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  inventory   Inventory[]
  allocations FulfillmentAllocation[]

  @@map("warehouses")
}

model Inventory {
  id                String   @id @default(uuid(7)) @db.Uuid
  warehouseId       String   @map("warehouse_id") @db.Uuid
  productId         String   @map("product_id") @db.Uuid
  availableQuantity Int      @default(0) @map("available_quantity")
  reservedQuantity  Int      @default(0) @map("reserved_quantity")
  reorderPoint      Int      @default(0) @map("reorder_point")
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([warehouseId, productId])
  @@index([productId])
  @@map("inventory")
}

enum FulfillmentStatus {
  NOT_STARTED
  ALLOCATING
  ALLOCATED
  PARTIALLY_FULFILLED
  BACKORDERED
  FULFILLED
  CANCELLED
}

model Fulfillment {
  id                     String            @id @default(uuid(7)) @db.Uuid
  quotationId            String            @unique @map("quotation_id") @db.Uuid
  status                 FulfillmentStatus @default(NOT_STARTED)
  estimatedShipmentCount Int               @default(0) @map("estimated_shipment_count")
  estimatedShipmentCost  Decimal           @default(0) @map("estimated_shipment_cost") @db.Decimal(14, 2)
  /// True when an authorized user replaced the recommended split. Overrides are
  /// still inventory-validated (docs/BUSINESS_RULES.md 7).
  manualOverride         Boolean           @default(false) @map("manual_override")
  createdAt              DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  quotation   Quotation               @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  allocations FulfillmentAllocation[]
  backorders  Backorder[]

  @@map("fulfillments")
}

model FulfillmentAllocation {
  id              String   @id @default(uuid(7)) @db.Uuid
  fulfillmentId   String   @map("fulfillment_id") @db.Uuid
  warehouseId     String   @map("warehouse_id") @db.Uuid
  productId       String   @map("product_id") @db.Uuid
  quotationLineId String?  @map("quotation_line_id") @db.Uuid
  quantity        Int
  shipmentCost    Decimal  @default(0) @map("shipment_cost") @db.Decimal(14, 2)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  fulfillment   Fulfillment    @relation(fields: [fulfillmentId], references: [id], onDelete: Cascade)
  warehouse     Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  product       Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  quotationLine QuotationLine? @relation(fields: [quotationLineId], references: [id], onDelete: SetNull)

  @@index([fulfillmentId])
  @@index([warehouseId, productId])
  @@map("fulfillment_allocations")
}

enum BackorderStatus {
  OPEN
  STOCK_AVAILABLE
  CONSOLIDATED
  CANCELLED
}

model Backorder {
  id              String          @id @default(uuid(7)) @db.Uuid
  fulfillmentId   String          @map("fulfillment_id") @db.Uuid
  productId       String          @map("product_id") @db.Uuid
  quotationLineId String?         @map("quotation_line_id") @db.Uuid
  quantity        Int
  status          BackorderStatus @default(OPEN)
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  resolvedAt      DateTime?       @map("resolved_at") @db.Timestamptz(6)

  fulfillment   Fulfillment    @relation(fields: [fulfillmentId], references: [id], onDelete: Cascade)
  product       Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  quotationLine QuotationLine? @relation(fields: [quotationLineId], references: [id], onDelete: SetNull)

  @@index([status, productId])
  @@map("backorders")
}

// ===========================================================================
// Subscriptions and billing
// ===========================================================================

enum BillingInterval {
  MONTHLY
  QUARTERLY
  YEARLY
}

enum ProrationRule {
  NONE
  DAILY_PRORATION
  FULL_PERIOD
}

enum CancellationRule {
  IMMEDIATE
  END_OF_PERIOD
}

enum RefundRule {
  NONE
  PARTIAL_PRORATED
  FULL
}

model SubscriptionPlan {
  id               String           @id @default(uuid(7)) @db.Uuid
  code             String           @unique
  name             String
  interval         BillingInterval
  prorationRule    ProrationRule    @default(DAILY_PRORATION) @map("proration_rule")
  cancellationRule CancellationRule @default(END_OF_PERIOD) @map("cancellation_rule")
  refundRule       RefundRule       @default(PARTIAL_PRORATED) @map("refund_rule")
  active           Boolean          @default(true)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  products       Product[]
  subscriptions  Subscription[]
  quotationLines QuotationLine[]

  @@map("subscription_plans")
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  MODIFIED
  CANCELLED
  EXPIRED
}

model Subscription {
  id              String             @id @default(uuid(7)) @db.Uuid
  customerId      String             @map("customer_id") @db.Uuid
  quotationId     String?            @map("quotation_id") @db.Uuid
  productId       String             @map("product_id") @db.Uuid
  planId          String             @map("plan_id") @db.Uuid
  quantity        Int
  unitPrice       Decimal            @map("unit_price") @db.Decimal(14, 2)
  startDate       DateTime           @map("start_date") @db.Date
  nextBillingDate DateTime           @map("next_billing_date") @db.Date
  status          SubscriptionStatus @default(PENDING)
  cancelledAt     DateTime?          @map("cancelled_at") @db.Timestamptz(6)
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  customer  Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  quotation Quotation?       @relation(fields: [quotationId], references: [id], onDelete: SetNull)
  product   Product          @relation(fields: [productId], references: [id], onDelete: Restrict)
  plan      SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Restrict)

  schedules BillingSchedule[]
  invoices  Invoice[]

  @@index([customerId, status])
  @@index([status, nextBillingDate])
  @@map("subscriptions")
}

enum BillingScheduleStatus {
  SCHEDULED
  INVOICED
  SKIPPED
  CANCELLED
}

model BillingSchedule {
  id             String                @id @default(uuid(7)) @db.Uuid
  subscriptionId String                @map("subscription_id") @db.Uuid
  periodStart    DateTime              @map("period_start") @db.Date
  periodEnd      DateTime              @map("period_end") @db.Date
  amount         Decimal               @db.Decimal(14, 2)
  status         BillingScheduleStatus @default(SCHEDULED)
  invoiceId      String?               @map("invoice_id") @db.Uuid
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  invoice      Invoice?     @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@unique([subscriptionId, periodStart])
  @@index([status, periodStart])
  @@map("billing_schedules")
}

enum InvoiceType {
  ONE_TIME
  RECURRING
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

model Invoice {
  id             String        @id @default(uuid(7)) @db.Uuid
  invoiceNumber  String        @unique @map("invoice_number")
  customerId     String        @map("customer_id") @db.Uuid
  quotationId    String?       @map("quotation_id") @db.Uuid
  subscriptionId String?       @map("subscription_id") @db.Uuid
  type           InvoiceType
  status         InvoiceStatus @default(DRAFT)
  currency       String        @default("INR")
  amount         Decimal       @db.Decimal(14, 2)
  amountPaid     Decimal       @default(0) @map("amount_paid") @db.Decimal(14, 2)
  issuedAt       DateTime?     @map("issued_at") @db.Timestamptz(6)
  dueDate        DateTime?     @map("due_date") @db.Date
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  customer     Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  quotation    Quotation?    @relation(fields: [quotationId], references: [id], onDelete: Restrict)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  lines            InvoiceLine[]
  payments         Payment[]
  creditNotes      CreditNote[]
  billingSchedules BillingSchedule[]

  @@index([customerId, status])
  @@index([quotationId])
  @@map("invoices")
}

model InvoiceLine {
  id          String  @id @default(uuid(7)) @db.Uuid
  invoiceId   String  @map("invoice_id") @db.Uuid
  productId   String? @map("product_id") @db.Uuid
  description String
  quantity    Int
  unitAmount  Decimal @map("unit_amount") @db.Decimal(14, 2)
  amount      Decimal @db.Decimal(14, 2)

  invoice Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@map("invoice_lines")
}

enum PaymentStatus {
  RECORDED
  FAILED
  REFUNDED
}

model Payment {
  id           String        @id @default(uuid(7)) @db.Uuid
  invoiceId    String        @map("invoice_id") @db.Uuid
  amount       Decimal       @db.Decimal(14, 2)
  method       String?
  reference    String?
  status       PaymentStatus @default(RECORDED)
  recordedById String?       @map("recorded_by_id") @db.Uuid
  paidAt       DateTime      @default(now()) @map("paid_at") @db.Timestamptz(6)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  invoice    Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  recordedBy User?   @relation("PaymentRecordedBy", fields: [recordedById], references: [id], onDelete: Restrict)

  @@index([invoiceId])
  @@map("payments")
}

model CreditNote {
  id               String   @id @default(uuid(7)) @db.Uuid
  creditNoteNumber String   @unique @map("credit_note_number")
  invoiceId        String   @map("invoice_id") @db.Uuid
  amount           Decimal  @db.Decimal(14, 2)
  reason           String
  createdById      String?  @map("created_by_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  createdBy User?   @relation("CreditNoteCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([invoiceId])
  @@map("credit_notes")
}

// ===========================================================================
// Recommendations
// ===========================================================================

model ProductPairing {
  id                   String   @id @default(uuid(7)) @db.Uuid
  productId            String   @map("product_id") @db.Uuid
  recommendedProductId String   @map("recommended_product_id") @db.Uuid
  /// Ranking weight, typically derived from co-purchase history.
  weight               Decimal  @default(1) @map("weight") @db.Decimal(10, 4)
  active               Boolean  @default(true)
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  product            Product @relation("PairingSource", fields: [productId], references: [id], onDelete: Cascade)
  recommendedProduct Product @relation("PairingRecommended", fields: [recommendedProductId], references: [id], onDelete: Cascade)

  @@unique([productId, recommendedProductId])
  @@index([productId, active])
  @@map("product_pairings")
}

model Promotion {
  id        String    @id @default(uuid(7)) @db.Uuid
  code      String    @unique
  name      String
  productId String    @map("product_id") @db.Uuid
  active    Boolean   @default(true)
  priority  Int       @default(0)
  startsAt  DateTime? @map("starts_at") @db.Timestamptz(6)
  endsAt    DateTime? @map("ends_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, active])
  @@map("promotions")
}

// ===========================================================================
// Audit and deal health
// ===========================================================================

/// Append-only. There is no update or delete path in application code, and the
/// actor FK is Restrict so a user with history cannot be deleted (AGENTS.md 20).
model AuditLog {
  id            String   @id @default(uuid(7)) @db.Uuid
  actorUserId   String?  @map("actor_user_id") @db.Uuid
  actorRole     Role?    @map("actor_role")
  entityType    String   @map("entity_type")
  entityId      String   @map("entity_id")
  action        String
  oldValue      Json?    @map("old_value")
  newValue      Json?    @map("new_value")
  reason        String?
  /// Quotation (or other entity) version the action applied to, where relevant.
  entityVersion Int?     @map("entity_version")
  ip            String?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

enum DealHealthEventType {
  STALLED
  DISCOUNT_ANOMALY
  DELIVERY_SLIPPAGE
  APPROVAL_DELAY
  FULFILLMENT_PROBLEM
}

enum DealHealthSeverity {
  INFO
  WARNING
  CRITICAL
}

model DealHealthEvent {
  id          String              @id @default(uuid(7)) @db.Uuid
  quotationId String              @map("quotation_id") @db.Uuid
  type        DealHealthEventType
  severity    DealHealthSeverity  @default(WARNING)
  metadata    Json?
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  resolvedAt  DateTime?           @map("resolved_at") @db.Timestamptz(6)

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([quotationId, type])
  @@index([type, resolvedAt])
  @@map("deal_health_events")
}
