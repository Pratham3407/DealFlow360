# --- DealFlow360 API environment ---
# Copy to `.env` and adjust. `.env` is git-ignored.

NODE_ENV=development
PORT=4000

# Local PostgreSQL 16. Replace `rudra` with your database role if different.
DATABASE_URL=postgresql://rudra@localhost:5432/dealflow360

# Must be at least 32 characters. Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-development-secret-value
JWT_EXPIRES_IN=12h

MAGIC_LINK_TTL_MINUTES=60
CORS_ORIGINS=http://localhost:5173
PORTAL_BASE_URL=http://localhost:5173/portal

BCRYPT_ROUNDS=10
LOG_LEVEL=info

# Minutes between deal-health sweeps. 0 disables the background timer.
DEAL_HEALTH_SWEEP_MINUTES=15
