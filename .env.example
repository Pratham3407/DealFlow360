# DealFlow360 - server environment template
#
# Copy to server/.env and fill in real values. Never commit server/.env.
# The local development role/databases are created by:
#   psql -U postgres -c "CREATE ROLE dealflow LOGIN PASSWORD '<pw>' CREATEDB"
#   psql -U postgres -c "CREATE DATABASE dealflow360 OWNER dealflow"
#   psql -U postgres -c "CREATE DATABASE dealflow360_test OWNER dealflow"
#
# CREATEDB is required because `prisma migrate dev` provisions a temporary
# shadow database to diff migrations against.

NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# Application database.
DATABASE_URL="postgresql://dealflow:REPLACE_ME@127.0.0.1:5432/dealflow360?schema=public"

# Separate database used by the integration test suite. It is truncated between
# tests, so it must never point at the application database.
TEST_DATABASE_URL="postgresql://dealflow:REPLACE_ME@127.0.0.1:5432/dealflow360_test?schema=public"

# Session cookie holding the opaque session token. Only the SHA-256 hash of the
# token is stored server-side, so this value is not itself a secret.
SESSION_COOKIE_NAME=df360_session
SESSION_TTL_HOURS=12

# Only needed when the web app is served from a different origin than the API.
# In development Vite proxies /api to this server, so it stays empty.
CORS_ORIGIN=
